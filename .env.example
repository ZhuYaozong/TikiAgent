# OpenAI-compatible model backend
TIKI_LLM_API_KEY=replace-with-your-api-key
TIKI_LLM_BASE_URL=https://api.deepseek.com
TIKI_LLM_MODEL=deepseek-v4-flash
TIKI_LLM_TIMEOUT_SECONDS=60
TIKI_LLM_MAX_RETRIES=1
TIKI_LLM_CONTEXT_LIMIT=32000
TIKI_LLM_MAX_OUTPUT_TOKENS=2000

# 正式应用按阶段覆盖输出上限；旧 MAX_OUTPUT 仅用于未分阶段的客户端。
TIKI_OUTPUT_ROUTER=512
TIKI_OUTPUT_CHAT=2048
TIKI_OUTPUT_SUPERVISOR=3072
TIKI_OUTPUT_CODE_AGENT=8192
TIKI_OUTPUT_CODE_FINAL=3072
TIKI_OUTPUT_RESEARCH_AGENT=2048
TIKI_OUTPUT_RESEARCH_FINAL=4096
TIKI_OUTPUT_VERIFIER=2048
TIKI_OUTPUT_VERIFIER_FINAL=4096
TIKI_OUTPUT_SUMMARY=2048

# 任务模型请求包括路由/压缩/显式重试，保留16次收尾请求，ASK恢复不刷新。
TIKI_BUDGET_MODEL_REQUESTS=64
TIKI_BUDGET_TASK_WEB_TOOLS=6
TIKI_BUDGET_TASK_CODE_TOOLS=48
TIKI_BUDGET_SUPERVISOR_STEPS=12
TIKI_BUDGET_SUPERVISOR_TOOLS=20
TIKI_BUDGET_RESEARCH_STEPS=4
TIKI_BUDGET_RESEARCH_SEARCHES=2
TIKI_BUDGET_RESEARCH_EXTRACTS=2
TIKI_BUDGET_CODE_STEPS=12
TIKI_BUDGET_CODE_TOOLS=24
TIKI_BUDGET_VERIFIER_STEPS=4
TIKI_BUDGET_VERIFIER_TOOLS=6
TIKI_BUDGET_DELEGATIONS=5
TIKI_BUDGET_REPEAT_LIMIT=2

# Web search backend（ResearchAgent 路由实际发生时才读取）
TIKI_SEARCH_PROVIDER=tavily
TIKI_TAVILY_API_KEY=tvly-replace-with-your-api-key
TIKI_TAVILY_BASE_URL=https://api.tavily.com
