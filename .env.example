# OpenAI-compatible model backend
TIKI_LLM_API_KEY=replace-with-your-api-key
TIKI_LLM_BASE_URL=https://api.deepseek.com
TIKI_LLM_MODEL=deepseek-flash
TIKI_LLM_API_STYLE=deepseek
TIKI_LLM_TIMEOUT_SECONDS=60
TIKI_LLM_MAX_RETRIES=1
TIKI_LLM_CONTEXT_LIMIT=131072
TIKI_LLM_MAX_OUTPUT_TOKENS=2000

# 正式应用按阶段覆盖输出上限；旧 MAX_OUTPUT 仅用于未分阶段的客户端。
TIKI_OUTPUT_ROUTER=2048
TIKI_OUTPUT_CHAT=8192
TIKI_OUTPUT_SUPERVISOR=16384
TIKI_OUTPUT_CODE_AGENT=32768
TIKI_OUTPUT_CODE_FINAL=16384
TIKI_OUTPUT_RESEARCH_AGENT=16384
TIKI_OUTPUT_RESEARCH_FINAL=16384
TIKI_OUTPUT_VERIFIER=16384
TIKI_OUTPUT_VERIFIER_FINAL=16384
TIKI_OUTPUT_SUMMARY=8192

# 仅 DeepSeek 适配发送专用思考参数；其他兼容接口使用 openai。
TIKI_THINKING_ROUTER=none
TIKI_THINKING_CHAT=low
TIKI_THINKING_SUPERVISOR=high
TIKI_THINKING_CODE_AGENT=high
TIKI_THINKING_CODE_FINAL=low
TIKI_THINKING_RESEARCH_AGENT=low
TIKI_THINKING_RESEARCH_FINAL=low
TIKI_THINKING_VERIFIER=high
TIKI_THINKING_VERIFIER_FINAL=low
TIKI_THINKING_SUMMARY=low

# Base/Local 为软压缩阈值；完整请求扣除输出和 2000 安全余量后硬检查。
TIKI_CONTEXT_BASE_BUDGET=32000
TIKI_CONTEXT_LOCAL_BUDGET=48000
TIKI_CONTEXT_RECENT_INTERACTIONS=8
TIKI_CONTEXT_RECENT_TOKENS=16000
TIKI_CONTEXT_COMPRESSION_RATIO=0.85

# 任务模型请求包括路由/压缩/显式重试，保留16次收尾请求，ASK恢复不刷新。
TIKI_BUDGET_MODEL_REQUESTS=128
TIKI_BUDGET_TASK_WEB_TOOLS=20
TIKI_BUDGET_TASK_CODE_TOOLS=64
TIKI_BUDGET_SUPERVISOR_STEPS=20
TIKI_BUDGET_SUPERVISOR_TOOLS=32
TIKI_BUDGET_RESEARCH_STEPS=10
TIKI_BUDGET_RESEARCH_SEARCHES=4
TIKI_BUDGET_RESEARCH_EXTRACTS=6
TIKI_BUDGET_CODE_STEPS=16
TIKI_BUDGET_CODE_TOOLS=32
TIKI_BUDGET_VERIFIER_STEPS=6
TIKI_BUDGET_VERIFIER_TOOLS=10
TIKI_BUDGET_DELEGATIONS=5
TIKI_BUDGET_REPEAT_LIMIT=2

# Web search backend（ResearchAgent 路由实际发生时才读取）
TIKI_SEARCH_PROVIDER=tavily
TIKI_TAVILY_API_KEY=tvly-replace-with-your-api-key
TIKI_TAVILY_BASE_URL=https://api.tavily.com
